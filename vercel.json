{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm --prefix frontend install && ./scripts/fetch-cv-assets.sh",
  "framework": null,
  "rewrites": [{ "source": "/((?!assets/|mediapipe/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/mediapipe/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
