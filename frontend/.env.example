# Copy to .env.local for a local override, or set in the Vercel dashboard.
#
# Leave empty for local development: requests stay relative and Vite proxies
# them to the backend on :8000.
#
# In production set this to the deployed API origin, with no trailing slash,
# and add the Vercel URL to the API's PHYSIOPILOT_CORS_ORIGINS.
VITE_API_BASE_URL=
