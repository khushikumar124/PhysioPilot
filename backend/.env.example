# Copy to .env and adjust. Never commit real secrets.
PHYSIOPILOT_SECRET_KEY=change-me-to-a-long-random-string
PHYSIOPILOT_DATABASE_URL=sqlite:///./physiopilot.db
PHYSIOPILOT_ACCESS_TOKEN_EXPIRE_MINUTES=720
PHYSIOPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set true on a fresh demo deployment to create the demo clinic on first boot.
# It only runs when the database has no users, so it is safe across redeploys.
PHYSIOPILOT_SEED_DEMO_ON_STARTUP=false

# Optional: enables the LLM-backed assistant. Without it the assistant falls
# back to a deterministic, plan-grounded responder (still fully functional).
PHYSIOPILOT_ANTHROPIC_API_KEY=
PHYSIOPILOT_ASSISTANT_MODEL=claude-sonnet-5
